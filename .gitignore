# dependencies
node_modules/

# builds — anchored to the actual generated-output locations, not bare
# patterns. A bare `lib/` here once silently swallowed apps/mobile/src/lib
# and functions/src/lib (real source, not build output) from every commit
# — don't repeat that.
/packages/core/dist/
/functions/lib/
build/
.expo/
.expo-shared/
web-build/

# native
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# env
.env
.env.local
*.local

# test/coverage
coverage/

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# editor/os
.DS_Store
*.log
