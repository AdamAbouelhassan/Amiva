rules_version = '2';

/**
 * Firestore Security Rules — technical_specification.md §6.
 *
 * Key rules enforced here:
 *  - `travelStyle` / `travelStyleBaseline` / `travelStyleLastUpdated` on a
 *    user doc are Cloud-Function-only writes (Admin SDK bypasses these
 *    rules entirely) — a client `update` may never change them. The one
 *    exception is document `create`: onboarding's 8 sliders are the
 *    user's first, self-declared baseline (functional_specification.md
 *    §2.3), so the initial value is a legitimate client write.
 *  - Read access to `experiences`, `trips`, and a user's travel style is
 *    gated by that owner's `privacySetting` (public/private/friends),
 *    checked against friend-edge existence for the `friends` case
 *    (functional_specification.md §3.6, §6.4).
 *  - `places` is world-readable, Cloud-Function-write-only (prevents
 *    client-side pollution of the normalized place list).
 *  - `friends` edges are never client-writable — compatibilityScore is
 *    server-computed, and the edge itself is only ever created by the
 *    `onFriendAdded` callable (technical_specification.md §5).
 *  - Raw phone numbers are never queried client-side for contacts-sync
 *    matching (technical_specification.md §6) — that matching happens
 *    inside a Cloud Function, out of scope for these declarative rules,
 *    but note `users/{uid}.phoneNumber` is still gated by the same
 *    privacySetting read rule as the rest of the profile below.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isFriendOf(ownerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/friends/$(ownerId + '_' + request.auth.uid));
    }

    /** Mirrors the account-wide privacy cascade
     * (functional_specification.md §3.6): the owner always sees their own
     * data; otherwise gated by privacySetting. */
    function canReadOwnedBy(ownerId, privacySetting) {
      return isOwner(ownerId) ||
        privacySetting == 'public' ||
        (privacySetting == 'friends' && isFriendOf(ownerId));
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // --- users -----------------------------------------------------------
    match /users/{uid} {
      allow read: if canReadOwnedBy(uid, resource.data.privacySetting);

      // Initial account creation: the client sets everything, including
      // the onboarding travel-style vector as the first baseline.
      allow create: if isOwner(uid);

      // Updates: owner only, and never allowed to touch the
      // server-computed style fields (Cloud Functions write these via
      // the Admin SDK, which is not subject to these rules at all).
      allow update: if isOwner(uid) &&
        unchanged('travelStyle') &&
        unchanged('travelStyleBaseline') &&
        unchanged('travelStyleLastUpdated');

      allow delete: if isOwner(uid);

      // FCM device tokens (infra addition — see
      // functions/src/adapters/pushAdapter.ts for why this isn't on the
      // User schema itself). Owner-only in both directions.
      match /fcmTokens/{token} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- usernames (uniqueness lookup) --------------------------------------
    // {username} -> { uid }. Deliberately world-readable and separate from
    // `users/{uid}` — usernames are a public identifier by design
    // (functional_specification.md §7: "Used for shareable profile
    // link/QR"), and a query over `users` filtered by username can't be
    // expressed safely against that collection's privacy-gated read rule
    // (see apps/mobile/src/repositories/userRepository.ts's header
    // comment for why). Claimed at account creation alongside the user
    // doc in one batch; a username *change* (Account → Settings) is a
    // batch that creates the new claim and deletes the old one — so
    // `delete` is allowed, but only by the claim's owner. `update` stays
    // forbidden: a rename must be delete-old + create-new, which keeps
    // the create rule as the uniqueness guard (a set on an already-taken
    // username is an update, and is denied — so races lose safely).
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // --- places ------------------------------------------------------------
    match /places/{placeId} {
      allow read: if true;
      allow write: if false; // Cloud Functions (Admin SDK) only
    }

    // --- trips (Logbook) ---------------------------------------------------
    match /trips/{tripId} {
      allow read: if canReadOwnedBy(resource.data.ownerId, resource.data.visibility);
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // --- experiences (Logbook entries / posts) ------------------------------
    match /experiences/{experienceId} {
      allow read: if canReadOwnedBy(
        resource.data.ownerId,
        get(/databases/$(database)/documents/users/$(resource.data.ownerId)).data.privacySetting
      );
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // --- saves ---------------------------------------------------------------
    // Doc id is `{userId}_{experienceId}`. A `get` on a *missing* save (the
    // common "is this saved?" check for an unsaved item) evaluates the rule
    // with `resource == null`, so `resource.data.userId` would error and the
    // read would be denied — hence the explicit null branch, gated on the
    // id prefix (Firebase uids never contain `_`).
    match /saves/{saveId} {
      allow read: if resource == null
        ? (isSignedIn() && saveId.split('_')[0] == request.auth.uid)
        : isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId); // "unsave"
      allow update: if false; // saves are immutable — delete + recreate instead
    }

    // --- savedPlaces (saved raw Google Places from Discover >
    // Recommendations, Discover rebuild 2026-08-30) — mirrors `saves`,
    // just keyed by placeId since a recommended place was never logged as
    // an experience. Feeds Planner's "Add from your saved places".
    match /savedPlaces/{savedPlaceId} {
      // Same missing-doc caveat as `saves` — id is `{userId}_{placeId}`.
      allow read: if resource == null
        ? (isSignedIn() && savedPlaceId.split('_')[0] == request.auth.uid)
        : isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow delete: if isOwner(resource.data.userId); // "unsave"
      allow update: if false;
    }

    // --- plannedTrips (shared-doc-style group co-editing) ---------------------
    match /plannedTrips/{plannedTripId} {
      function isCollaborator(data) {
        return isOwner(data.ownerId) || (isSignedIn() && request.auth.uid in data.collaboratorIds);
      }
      allow read: if canReadOwnedBy(resource.data.ownerId, resource.data.visibility) || isCollaborator(resource.data);
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      // Any collaborator can co-edit (functional_specification.md §6.1) —
      // unlimited collaborators, direct-add, no invite/accept step.
      allow update: if isCollaborator(resource.data);
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /plannedTripItems/{itemId} {
      function parentTrip() {
        return get(/databases/$(database)/documents/plannedTrips/$(resource.data.plannedTripId)).data;
      }
      function parentTripOnCreate() {
        return get(/databases/$(database)/documents/plannedTrips/$(request.resource.data.plannedTripId)).data;
      }
      function isCollaboratorOf(trip) {
        return isOwner(trip.ownerId) || (isSignedIn() && request.auth.uid in trip.collaboratorIds);
      }
      allow read: if isCollaboratorOf(parentTrip());
      allow create: if isCollaboratorOf(parentTripOnCreate());
      allow update, delete: if isCollaboratorOf(parentTrip());
    }

    // --- friends (bidirectional compatibility edges) ---------------------------
    match /friends/{edgeId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false; // onFriendAdded / onTravelStyleChanged (Admin SDK) only
    }

    // --- notifications -----------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientId);
      allow create, delete: if false; // Cloud Functions only
      // Client may mark its own notification read, nothing else.
      allow update: if isOwner(resource.data.recipientId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // --- config (tunable algorithm constants) -----------------------------------
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // set via console/admin tooling only
    }
  }
}
